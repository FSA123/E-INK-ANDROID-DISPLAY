<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/please_select_device"
            android:textColor="@color/black"
            android:textSize="@dimen/dp_14" />

        <Spinner
            android:id="@+id/spinner"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:layout_weight="1" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/please_select_screen_type"
            android:textColor="@color/black"
            android:textSize="@dimen/dp_14" />

        <Spinner
            android:id="@+id/spinner_screen_type"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:layout_weight="1" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/btn_connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect" />

        <Button
            android:id="@+id/btn_disconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/disconnect" />
        <Button
            android:id="@+id/btn_get_device_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/get_device_info" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_get_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/get_temperature" />
        <EditText
            android:id="@+id/et_temperature"
            android:layout_width="@dimen/dp_80"
            android:layout_height="wrap_content"
            android:hint="@string/temperature"
            android:textSize="@dimen/sp_12"
            android:inputType="number" />
        <Button
            android:id="@+id/btn_set_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_temperature" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_get_vcom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/get_vcom" />
        <EditText
            android:id="@+id/et_vcom"
            android:layout_width="@dimen/dp_80"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="@string/vcom"
            android:textSize="@dimen/sp_12" />
        <Button
            android:id="@+id/btn_set_vcom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_vcom" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

           <LinearLayout
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:orientation="vertical">
               <ImageView
                   android:id="@+id/iv_img"
                   android:layout_width="@dimen/dp_240"
                   android:layout_height="@dimen/dp_155"
                   />

           </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_select_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_image"
                    />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="X" />

                    <EditText
                        android:id="@+id/et_x"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="number"
                        android:minWidth="@dimen/dp_30"
                        android:text="0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Y" />

                    <EditText
                        android:id="@+id/et_y"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="number"
                        android:minWidth="@dimen/dp_30"
                        android:text="0"

                        />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/img_width" />

                    <EditText
                        android:id="@+id/et_w"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="number"
                        android:minWidth="@dimen/dp_30"
                        android:text="3200" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/img_height" />

                    <EditText
                        android:id="@+id/et_h"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="number"
                        android:minWidth="@dimen/dp_30"
                        android:text="1800" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/display_mode" />

                    <EditText
                        android:id="@+id/et_display_mode"
                        android:layout_width="@dimen/dp_30"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="0" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_refresh_mode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_30"
                android:orientation="horizontal"
                android:visibility="gone"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="@string/please_select_refresh_mode"
                    android:textColor="@color/black"
                    android:textSize="@dimen/dp_14" />

                <Spinner
                    android:id="@+id/spinner_refresh_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="@dimen/dp_100"
                    android:background="@color/white"
                     />
            </LinearLayout>
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content">

              <CheckBox
                  android:id="@+id/cb_dither"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginRight="@dimen/dp_5"
                  android:checked="false"
                  android:visibility="visible"
                  android:text="@string/dither" />
              <Button
                  android:id="@+id/btn_load_img"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="@string/load_image" />
              <Button
                  android:id="@+id/btn_display_img"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="@string/display" />
              <Button
                  android:id="@+id/btn_display_clear"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="@string/clear_screen" />
          </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/firmware_upgrade"
        android:textStyle="bold"
        android:textSize="@dimen/dp_14" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible"
        android:gravity="center">

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rb_firmware"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="firmware"/>
            <RadioButton
                android:id="@+id/rb_waveform"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="waveform"/>
        </RadioGroup>

        <LinearLayout
            android:id="@+id/ll_update_file"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_30"
            android:background="@color/white"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_update_file"
                android:layout_width="wrap_content"
                android:minWidth="@dimen/dp_100"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/select_file"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:textSize="@dimen/dp_14" />

            <ImageView
                android:layout_width="@dimen/dp_19"
                android:layout_height="@dimen/dp_20"
                android:layout_marginRight="@dimen/dp_10"
                android:background="@drawable/ic_setting_right_arrow" />
        </LinearLayout>
        <Button
            android:id="@+id/btn_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upgrade" />
        >

    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">


        <Button
            android:id="@+id/btn_start_du_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start DU Test" />
        <Button
            android:id="@+id/btn_start_gc16_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start GC16 Test" />
        <Button
            android:id="@+id/btn_local_image_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Local Image Test" />
        <Button
            android:id="@+id/btn_stop_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop Test" />
    </LinearLayout>
<!--    日志-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log" />

            <Button
                android:id="@+id/btn_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:overScrollMode="never">

            <TextView
                android:id="@+id/tv_msg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#666"
                android:textSize="14sp" />
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</LinearLayout>