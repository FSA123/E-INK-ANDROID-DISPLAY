<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/line_title"
            android:drawablePadding="@dimen/dp_5"
            android:text="@string/device_init_setting"
            android:textColor="@color/colorPrimaryText"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_35"
            android:background="@drawable/list_item_bg_white"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_5"
                android:text="@string/epd_type"
                android:textColor="@color/colorPrimaryText"
                android:textSize="@dimen/sp_12" />

            <com.xingtai.epd.device.demo.widget.MySpinner
                android:id="@+id/spinner_epd_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/white"
                android:theme="@style/SpinnerStyle" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_battery_type"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_35"
            android:background="@drawable/list_item_bg_white"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_5"
                android:text="@string/battery_type"
                android:textColor="@color/colorPrimaryText"
                android:textSize="@dimen/sp_12" />

            <com.xingtai.epd.device.demo.widget.MySpinner
                android:id="@+id/spinner_battery_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/white"
                android:theme="@style/SpinnerStyle" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_auto_open_front_light"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_35"
            android:background="@drawable/list_item_bg_white"
            android:gravity="center_vertical"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_open_front_light"
                android:textColor="@color/colorPrimaryText"
                android:layout_marginLeft="@dimen/dp_5"
                android:textSize="@dimen/sp_12" />

            <CheckBox
                android:id="@+id/cb_auto_open_front_light"
                style="@style/SwitchStyle"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:layout_marginLeft="@dimen/dp_5"
                android:checked="true" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_auto_auto_launch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_35"
            android:background="@drawable/list_item_bg_white"
            android:gravity="center_vertical"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_boot_app"
                android:textColor="@color/colorPrimaryText"
                android:layout_marginLeft="@dimen/dp_5"
                android:textSize="@dimen/sp_12" />

            <CheckBox
                android:id="@+id/cb_auto_boot_app"
                style="@style/SwitchStyle"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:layout_marginLeft="@dimen/dp_5"
                android:checked="true" />
        </LinearLayout>
        <Button
            android:id="@+id/btn_app_config"
            style="@style/BaseBtnCommon"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_30"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dp_5"
            android:text="Confirm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/line_title"
            android:drawablePadding="@dimen/dp_5"
            android:text="@string/serial_setting"
            android:textColor="@color/colorPrimaryText"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_35"
            android:background="@drawable/list_item_bg_white"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_5"
                android:text="@string/serial_path"
                android:textColor="@color/colorPrimaryText"
                android:textSize="@dimen/sp_12" />

            <com.xingtai.epd.device.demo.widget.MySpinner
                android:id="@+id/spinner_serial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/white"
                android:theme="@style/SpinnerStyle" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_serial_config"
            style="@style/BaseBtnCommon"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_30"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dp_5"
            android:text="Confirm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:drawableLeft="@drawable/line_title"
            android:drawablePadding="@dimen/dp_5"
            android:text="@string/mqtt_config"
            android:textColor="@color/colorPrimaryText"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_50"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/dp_50"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="@dimen/dp_90"
                    android:layout_height="wrap_content"
                    android:text="Client ID"
                    android:textColor="@color/colorPrimaryText"
                    android:textSize="@dimen/sp_12" />

                <EditText
                    android:id="@+id/et_client_id"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_35"
                    android:background="#ffffff"
                    android:hint="input client id"
                    android:maxLines="1"
                    android:padding="@dimen/dp_5"
                    android:singleLine="true"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="@dimen/dp_90"
                    android:layout_height="wrap_content"
                    android:text="IP"
                    android:textColor="@color/colorPrimaryText"
                    android:textSize="@dimen/sp_12" />

                <EditText
                    android:id="@+id/et_ip"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_35"
                    android:background="#ffffff"
                    android:hint="input service ip"
                    android:maxLines="1"
                    android:padding="@dimen/dp_5"
                    android:singleLine="true"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="@dimen/dp_90"
                    android:layout_height="wrap_content"
                    android:text="Port"
                    android:textColor="@color/colorPrimaryText"
                    android:textSize="@dimen/sp_12" />

                <EditText
                    android:id="@+id/et_port"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_35"
                    android:background="#ffffff"
                    android:hint="input port"
                    android:inputType="number"
                    android:maxLines="1"
                    android:text="1883"
                    android:padding="@dimen/dp_5"
                    android:singleLine="true"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="@dimen/dp_90"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textColor="@color/colorPrimaryText"
                    android:textSize="@dimen/sp_12" />

                <EditText
                    android:id="@+id/et_username"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_35"
                    android:background="#ffffff"
                    android:hint="username"
                    android:maxLines="1"
                    android:padding="@dimen/dp_5"
                    android:singleLine="true"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="@dimen/dp_90"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="@color/colorPrimaryText"
                    android:textSize="@dimen/sp_12" />

                <EditText
                    android:id="@+id/et_pwd"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_35"
                    android:background="#ffffff"
                    android:hint="password"
                    android:maxLines="1"
                    android:padding="@dimen/dp_5"
                    android:singleLine="true"
                    android:textSize="@dimen/sp_12" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="@dimen/dp_90"
                    android:layout_height="wrap_content"
                    android:text="Subscribe topic"
                    android:textColor="@color/colorPrimaryText"
                    android:textSize="@dimen/sp_12" />

                <EditText
                    android:id="@+id/et_sub_topic"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_35"
                    android:background="#ffffff"
                    android:hint="subscribe topic"
                    android:maxLines="1"
                    android:padding="@dimen/dp_5"
                    android:singleLine="true"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>


            <Button
                android:id="@+id/btn_mqtt_config"
                style="@style/BaseBtnCommon"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_30"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp_5"
                android:text="Confirm"
                android:textSize="@dimen/sp_12" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_start_service"
                style="@style/BtnBigRed"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:layout_marginBottom="@dimen/dp_0"
                android:text="@string/start_service" />

            <Button
                android:id="@+id/btn_stop_service"
                style="@style/BtnBigRed"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/dp_0"
                android:layout_weight="1"
                android:text="@string/stop_service" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
