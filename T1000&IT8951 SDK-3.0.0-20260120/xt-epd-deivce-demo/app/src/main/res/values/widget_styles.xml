<resources>

    <style name="SpinnerStyle">
        <item name="android:textSize">12sp</item>
    </style>
    <!--    默认蓝-->
    <style name="BaseBtnCommon">
        <item name="android:background">@drawable/btn_blue_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/dp_12</item>
    </style>

    <style name="BaseBtnCommonRed">
        <item name="android:background">@drawable/btn_sure_full_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/dp_12</item>
    </style>

    <style name="BtnBig" parent="BaseBtnCommon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/dp_35</item>
        <item name="android:layout_marginLeft">@dimen/dp_35</item>
        <item name="android:layout_marginRight">@dimen/dp_35</item>
        <item name="android:layout_marginTop">@dimen/dp_10</item>
        <item name="android:layout_marginBottom">@dimen/dp_10</item>
        <item name="android:enabled">false</item>
    </style>

    <style name="BtnBigRed" parent="BaseBtnCommonRed">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/dp_35</item>
        <item name="android:layout_marginLeft">@dimen/dp_35</item>
        <item name="android:layout_marginRight">@dimen/dp_35</item>
        <item name="android:layout_marginTop">@dimen/dp_10</item>
        <item name="android:layout_marginBottom">@dimen/dp_10</item>
    </style>

    <style name="SwitchStyle">
        <item name="android:layout_width">@dimen/dp_32</item>
        <item name="android:layout_height">@dimen/dp_32</item>
        <item name="android:layout_alignParentRight">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:layout_marginRight">@dimen/dp_15</item>
        <item name="android:background">@drawable/status_switch_selector</item>
        <item name="android:button">@null</item>
    </style>

</resources>
